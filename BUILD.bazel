load("@rules_python//python:defs.bzl", "py_test")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("//:bazel/python_extension.bzl", "copy_extension")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.Accelerators.lock",
    "Cargo.Accelerators.Bazel.lock",
    "Cargo.Bazel.lock",
    "LICENSE",
    "NOTICE",
])

filegroup(
    name = "faiss_metal_test",
    srcs = ["buck2/native/faiss_metal_test.cpp"],
)

alias(
    name = "cpu",
    actual = "//rust/crates/ennx:ennx_cpu",
)

alias(
    name = "gpu",
    actual = select({
        "@platforms//os:macos": "//rust/crates/ennx:ennx_metal",
        "//conditions:default": "//rust/crates/ennx:ennx_opencl",
    }),
)

alias(
    name = "ext",
    actual = "//rust/crates/ennx-py:python_extension",
)

filegroup(
    name = "python_sources",
    srcs = glob(["src/ennx/**/*.py"]),
)

copy_extension(
    name = "wheel_extension_unix",
    src = "//rust/crates/ennx-py:python_extension_unix",
    output = "ennx/ennx_rust.so",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

copy_extension(
    name = "wheel_extension_windows",
    src = "//rust/crates/ennx-py:python_extension_windows",
    output = "ennx/ennx_rust.pyd",
    target_compatible_with = ["@platforms//os:windows"],
)

alias(
    name = "wheel_extension",
    actual = select({
        "@platforms//os:windows": ":wheel_extension_windows",
        "//conditions:default": ":wheel_extension_unix",
    }),
)

py_wheel(
    name = "wheel",
    abi = "cp313",
    description_content_type = "text/plain",
    description_file = "README",
    distribution = "ennx",
    extra_distinfo_files = {
        ":LICENSE": "licenses/LICENSE",
        ":NOTICE": "licenses/NOTICE",
    },
    extra_requires = {
        "full": [
            "gpytorch>=1.13",
            "scipy>=1.15.3",
            "torch>=2.5.1",
        ],
    },
    homepage = "https://github.com/Kvutza/ennx",
    license = "MIT",
    platform = select({
        "@platforms//os:linux": "manylinux_2_28_x86_64",
        "@platforms//os:macos": "macosx_11_0_arm64",
        "@platforms//os:windows": "win_amd64",
        "//conditions:default": "any",
    }),
    python_requires = ">=3.12,<3.14",
    python_tag = "cp313",
    requires = ["numpy>=2.1"],
    strip_path_prefixes = ["src"],
    summary = "Epistemic Nearest Neighbors",
    version = "0.1.0",
    deps = [
        ":python_sources",
        ":wheel_extension",
    ],
)

# Compatibility alias for //:python_wheel
alias(
    name = "python_wheel",
    actual = ":wheel",
)

test_suite(
    name = "check",
    tests = [
        "//bazel/faiss:faiss_index_smoke",
        "//rust/crates/bpann:bpann_test",
        "//rust/crates/ennx:ennx_test",
        "//rust/crates/ennx:trial_search_metal_test",
    ],
)

# Compatibility alias for //:rust_tests
alias(
    name = "rust_tests",
    actual = ":check",
)

py_test(
    name = "audit",
    srcs = ["bazel/audit_wheel.py"],
    args = ["$(location :wheel)"],
    data = [":wheel"],
    main = "bazel/audit_wheel.py",
)

# Compatibility alias for //:wheel_artifact_audit
alias(
    name = "wheel_artifact_audit",
    actual = ":audit",
)
