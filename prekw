#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$repo_dir"

"$repo_dir/tools/bootstrap-dotslash" >/dev/null
dotslash="$repo_dir/.buck2-tools/bin/dotslash"
if [ ! -x "$dotslash" ] && [ -x "$repo_dir/.buck2-tools/bin/dotslash.exe" ]; then
    dotslash="$repo_dir/.buck2-tools/bin/dotslash.exe"
fi

if [ "$#" -eq 1 ] && [ "$1" = "run" ]; then
    files=()
    while IFS= read -r path; do
        if [ -e "$repo_dir/$path" ] || [ -L "$repo_dir/$path" ]; then
            files+=("$path")
        fi
    done < <(jj diff --name-only)

    if [ "${#files[@]}" -eq 0 ]; then
        echo "No files changed in the JJ working copy."
        exit 0
    fi
    set -- run --files "${files[@]}"
fi

exec "$dotslash" "$repo_dir/tools/prek" "$@"
