    test = ":region-arithmetic",
    visibility = ["PUBLIC"],
)

rust_test(
    name = "region-opencl",
    srcs = glob([
        "src/**/*.cl",
        "src/**/*.metal",
        "src/**/*.rs",
    ]),
    crate = "ennx",
    crate_root = "src/lib.rs",
    edition = "2021",
    features = ["opencl", "usearch-native", "zig-dense"],
    visibility = ["PUBLIC"],
    deps = [
        "//rust:opencl3",
        ":usearch-bridge",
        "//zig:dense",
        "//rust/crates/bpann:bpann",
        "//rust:memmap2",
        "//rust:ndarray",
        "//rust:rand",
        "//rust:rand_chacha",
        "//rust:rand_distr",
        "//rust:rayon",
        "//rust:serde",
        "//rust:sobol",
        "//rust:tempfile",
        "//rust:thiserror",
        "//rust:toml",
    ] + select({
        "//:linux-arm64": [],
        "//:linux-x86_64": [],
        "//:macos-arm64": [
            "//buck2/native:openmp-macos",
            "//rust:metal",
        ],
    }),
    rpath = True,
    run_env = {"RUST_TEST_THREADS": "1"},
    runtime_dependency_handling = "symlink",
    rustc_flags = select({
        "//:macos-arm64": [
            "-Clink-arg=-Wl,-rpath,@loader_path/../../../../buck2/native/__openmp-build__/openmp/lib",
        ],
        "DEFAULT": [],
    }),
)

