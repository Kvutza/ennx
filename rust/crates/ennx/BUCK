# Each integration crate receives the same platform features as the library.
[
    rust_test(
        name = source.removeprefix("tests/").removesuffix(".rs") + "_test",
        srcs = [source, "src/lib.rs", "src/experimental.rs"],
        crate_root = source,
        edition = "2021",
        features = select({
            "//:macos-arm64": ["metal", "usearch-native", "zig-dense"],
            "DEFAULT": ["opencl", "usearch-native", "zig-dense"],
        }),
        deps = [
            ":ennx",
            "//rust:ndarray",
            "//rust:rand",
            "//rust:rand_chacha",
            "//rust:tempfile",
        ] + select({
            "//:macos-arm64": ["//buck2/native:openmp-macos"],
            "DEFAULT": [],
        }),
        visibility = ["PUBLIC"],
        rpath = True,
        runtime_dependency_handling = "symlink",
        run_env = {"RUST_TEST_THREADS": "1"},
        rustc_flags = select({
            "//:macos-arm64": [
                "-Clink-arg=-Wl,-rpath,@loader_path/../../../../buck2/native/__openmp-build__/openmp/lib",
            ],
            "DEFAULT": [],
        }),
        target_compatible_with = ["prelude//os/constraints:macos"] if source == "tests/knn_metal.rs" else [],
    )
    for source in glob(["tests/*.rs"])
]

_TESTS = [
    ":" + source.removeprefix("tests/").removesuffix(".rs") + "_test"
    for source in glob(["tests/*.rs"], exclude = ["tests/knn_metal.rs"])
] + select({
    "//:macos-arm64": [":knn_metal_test"],
    "DEFAULT": [],
})

test_suite(
    name = "integration",
    tests = _TESTS,
    visibility = ["//buck2/tests:all"],
)
