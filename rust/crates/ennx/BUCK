    crate_root = "src/lib.rs",
    edition = "2021",
    features = select({
        "//:linux-arm64": ["opencl", "usearch-native", "zig-dense"],
        "//:linux-x86_64": ["opencl", "usearch-native", "zig-dense"],
        "//:macos-arm64": ["metal", "usearch-native", "zig-dense"],
    }),
    visibility = ["PUBLIC"],
    deps = [
        ":faiss-bridge",
        ":usearch-bridge",
        "//zig:dense",
        "//rust/crates/bpann:bpann",
        "//rust:memmap2",
        "//rust:ndarray",
        "//rust:rand",
        "//rust:rayon",
        "//rust:serde",
        "//rust:sobol",
        "//rust:thiserror",
        "//rust:toml",
        "//rust:tracy-client",
        "//rust:tracy-client-sys",
    ] + select({
        "//:linux-arm64": ["//rust:opencl3"],
        "//:linux-x86_64": ["//rust:opencl3"],
        "//:macos-arm64": ["//rust:metal"],
    }),
)

