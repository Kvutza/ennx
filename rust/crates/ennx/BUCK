load("//buck2:reindeer_rules.bzl", "app_rust_binary", "app_rust_library")

filegroup(
    name = "ennx-source",
    srcs = glob([
        "examples/**/*.rs",
        "src/**/*.cl",
        "src/**/*.cpp",
        "src/**/*.h",
        "src/**/*.metal",
        "src/**/*.rs",
    ]) + [
        "build.rs",
        "Cargo.toml",
        "LICENSE",
        "NOTICE",
        "README.md",
    ],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "faiss-bridge",
    srcs = ["src/faiss_bridge.cpp"],
    compiler_flags = [
        "-std=c++20",
        "-Wno-deprecated-declarations",
    ],
    deps = ["//buck2/native:faiss"],
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "usearch-bridge",
