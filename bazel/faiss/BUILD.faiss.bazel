load("@rules_cc//cc:defs.bzl", "cc_library")
load("@ennx//bazel/faiss:faiss.bzl", "faiss_metal")

package(default_visibility = ["//visibility:public"])

# Build FAISS 1.14.3 directly with Bazel.

OMP_COPTS = select({
    "@platforms//os:linux": ["-fopenmp"],
    "@platforms//os:macos": [
        "-Xclang",
        "-fopenmp",
    ],
    "//conditions:default": [],
})

OMP_DEPS = ["@openmp//:openmp"]

CXX_COPTS = [
    "-std=c++20",
    "-Wno-deprecated-declarations",
    "-Wno-unknown-pragmas",
]

cc_library(
    name = "blas",
    deps = select({
        "@platforms//os:linux": ["@ennx//bazel/openblas"],
        "@platforms//os:macos": [":sdk_blas"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "sdk_blas",
    linkopts = select({
        "@platforms//os:macos": [
            "-framework",
            "Accelerate",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

FAISS_HEADERS = glob(
    ["faiss/**/*.h"],
    exclude = [
        "faiss/gpu/**",
        "faiss/gpu_metal/**",
        "faiss/python/**",
        "faiss/svs/**",
    ],
)

FAISS_SRCS = glob(
    ["faiss/**/*.cpp"],
    exclude = [
        "faiss/cppcontrib/**",
        "faiss/gpu/**",
        "faiss/gpu_metal/**",
        "faiss/impl/approx_topk/*.cpp",
        "faiss/impl/binary_hamming/*.cpp",
        "faiss/impl/fast_scan/impl-*.cpp",
        "faiss/impl/hnsw/avx*.cpp",
        "faiss/impl/pq_code_distance/avx*.cpp",
        "faiss/impl/pq_code_distance/neon.cpp",
        "faiss/impl/pq_code_distance/pq_code_distance-sve.cpp",
        "faiss/impl/pq_code_distance/rvv.cpp",
        "faiss/impl/scalar_quantizer/sq-*.cpp",
        "faiss/impl/svs_io.cpp",
        "faiss/invlists/OnDiskInvertedLists.cpp",
        "faiss/python/**",
        "faiss/svs/**",
        "faiss/build.cpp",
        "faiss/utils/distances_fused/avx512.cpp",
        "faiss/utils/distances_fused/simdlib_based.cpp",
        "faiss/utils/distances_fused/simdlib_based_neon.cpp",
        "faiss/utils/hamming_distance/*.cpp",
        "faiss/utils/simd_impl/*.cpp",
    ],
) + ["faiss/invlists/OnDiskInvertedLists.cpp"] + select({
    "@platforms//cpu:aarch64": [
        "faiss/impl/fast_scan/impl-neon.cpp",
        "faiss/impl/scalar_quantizer/sq-neon.cpp",
        "faiss/impl/approx_topk/neon.cpp",
        "faiss/impl/binary_hamming/neon.cpp",
        "faiss/impl/pq_code_distance/neon.cpp",
        "faiss/utils/simd_impl/distances_aarch64.cpp",
        "faiss/utils/hamming_distance/hamming_neon.cpp",
        "faiss/utils/simd_impl/partitioning_neon.cpp",
        "faiss/utils/distances_fused/simdlib_based_neon.cpp",
        "faiss/utils/simd_impl/rabitq_neon.cpp",
    ],
    "//conditions:default": [],
})

cc_library(
    name = "faiss",
    srcs = FAISS_SRCS,
    hdrs = FAISS_HEADERS,
    copts = CXX_COPTS + OMP_COPTS,
    defines = ["FINTEGER=int"] + select({
        "@platforms//cpu:aarch64": ["COMPILE_SIMD_ARM_NEON"],
        "//conditions:default": [],
    }),
    includes = ["."],
    deps = [
        ":blas",
    ] + OMP_DEPS,
)

cc_library(
    name = "faiss_c",
    srcs = glob(
        ["c_api/**/*.cpp"],
        exclude = ["c_api/gpu/**"],
    ),
    hdrs = glob(
        ["c_api/**/*.h"],
        exclude = ["c_api/gpu/**"],
    ),
    copts = CXX_COPTS + OMP_COPTS,
    includes = ["."],
    deps = [":faiss"] + OMP_DEPS,
)

faiss_metal()
