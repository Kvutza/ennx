load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

package(default_visibility = ["//visibility:public"])

# OpenBLAS is used only where an SDK BLAS is not available. Keeping it static
# makes the wheel independent of package-manager or system BLAS installations.
cmake(
    name = "openblas",
    cache_entries = {
        "BUILD_SHARED_LIBS": "OFF",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "DYNAMIC_ARCH": "ON",
        "NOFORTRAN": "ON",
        "NO_LAPACKE": "ON",
        "USE_OPENMP": "OFF",
    },
    lib_source = "@openblas_src//:all_srcs",
    out_include_dir = "include",
    out_static_libs = ["libopenblas.a"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
