#!/bin/sh
set -eu

compiler=$1
mode=$2
shift 2
if ! sdk=$(xcrun --sdk macosx --show-sdk-path); then
    echo "ennx: install Apple's SDK with: xcode-select --install" >&2
    exit 1
fi
if [ "$mode" = cxx ] || [ "$mode" = link ]; then
    set -- -nostdinc++ -isystem "$sdk/usr/include/c++/v1" "$@"
fi
if [ "$mode" = link ]; then
    linker=$(xcrun --sdk macosx --find ld)
    set -- "--ld-path=$linker" "$@"
fi
exec "$compiler" --no-default-config -isysroot "$sdk" -mmacosx-version-min=11.0 "$@"
