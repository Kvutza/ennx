#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

os=$(uname -s)
arch=$(uname -m)
case "$os:$arch" in
    Darwin:arm64)
        if ! sdk=$(xcrun --show-sdk-path); then
            echo "ennx: install Xcode command-line tools with: xcode-select --install" >&2
            exit 1
        fi
        required="clang clang++ ar otool install_name_tool"
        ;;
    Linux:x86_64|Linux:aarch64)
        required="clang clang++ ar ld.lld"
        ;;
    *)
        echo "ennx: unsupported build host: $(uname -s) $(uname -m)" >&2
        exit 1
        ;;
esac

probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/ennx-cxx.XXXXXX")
trap 'rm -rf "$probe_dir"' EXIT
trap 'exit 1' HUP INT TERM
printf '#include <string>\nint main() { return std::string("ennx").size() != 4; }\n' > "$probe_dir/probe.cpp"

host_ready() {
    for tool in $required; do
        command -v "$tool" >/dev/null 2>&1 || return 1
    done
    if [ "$os" = Linux ]; then
        clang++ -fuse-ld=lld "$probe_dir/probe.cpp" -o "$probe_dir/probe" || return 1
    else
        clang++ "$probe_dir/probe.cpp" -o "$probe_dir/probe" || return 1
    fi
    "$probe_dir/probe"
}

prefix="$repo_dir/.pixi/envs/native-tools"
if [ "$(command -v clang || true)" != "$prefix/bin/clang" ] && host_ready >/dev/null 2>&1; then
    exit 0
fi

managed_ready() {
    for tool in clang clang++ llvm-ar ld.lld ld64.lld; do
        [ -x "$prefix/bin/$tool" ] || return 1
    done
    "$prefix/bin/clang" --version | grep -Eq '^clang version 22[.]1[.]8([[:space:]]|$)' || return 1
    # Keep these flags aligned with toolchains/cxx.bzl.
    if [ "$os" = Linux ]; then
        "$prefix/bin/clang++" --no-default-config \
            "--sysroot=$prefix/$arch-conda-linux-gnu/sysroot" \
            "--gcc-install-dir=$prefix/lib/gcc/$arch-conda-linux-gnu/8.5.0" \
            "-L$prefix/lib" \
            "--ld-path=$prefix/bin/ld.lld" \
            "$probe_dir/probe.cpp" -o "$probe_dir/probe" || return 1
    else
        "$prefix/bin/clang++" --no-default-config \
            -isysroot "$sdk" -nostdinc++ -isystem "$sdk/usr/include/c++/v1" \
            "--ld-path=$prefix/bin/ld64.lld" \
            "$probe_dir/probe.cpp" -o "$probe_dir/probe" || return 1
    fi
    "$probe_dir/probe"
}

if managed_ready >/dev/null 2>&1; then
    printf '%s\n' "$prefix"
    exit 0
fi
echo "Preparing Clang and LLD toolchain..." >&2
sh tools/pixiw install --environment native-tools >&2
if ! managed_ready >&2; then
    echo "ennx: the managed C++ toolchain could not compile, link and run a program" >&2
    exit 1
fi
printf '%s\n' "$prefix"
