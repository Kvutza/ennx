#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

hashes_before=$(shasum -a 256 rust/BUCK buck2/accelerators/BUCK pixi.lock)
./tools/buck2-deps
hashes_after=$(shasum -a 256 rust/BUCK buck2/accelerators/BUCK pixi.lock)
test "$hashes_before" = "$hashes_after"
cmp Cargo.Accelerators.lock buck2/accelerators/Cargo.lock

./buck2w --isolation-dir dev test \
    //buck2/tests:all \
    --local-only \
    --num-threads 4 \
    --console simple
./buck2w --isolation-dir dev build //buck2/accelerators:opencl3 \
    --local-only \
    --num-threads 4 \
    --console simple
./tools/buck2-wheel-verify
ENNX_PYTHON_VERSION=3.12 \
    ENNX_PYTHON="$repo_dir/.pixi/envs/ennx-py312/bin/python" \
    ./tools/buck2-wheel-verify
