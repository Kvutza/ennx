#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

run_tests=0
case ${1:-} in
    "") ;;
    --tests) run_tests=1 ;;
    *)
        echo "usage: tools/buck2-wheel-verify [--tests]" >&2
        exit 2
        ;;
esac
test "$#" -le 1

fixture_restore_dir=
verify_dir=

cleanup() {
    if [ -n "$fixture_restore_dir" ] && [ -f "$fixture_restore_dir/paths" ]; then
        while IFS= read -r fixture; do
            cp "$fixture_restore_dir/files/$fixture" "$repo_dir/$fixture"
        done < "$fixture_restore_dir/paths"
        rm -rf "$fixture_restore_dir"
    fi
    if [ -n "$verify_dir" ]; then
        rm -rf "$verify_dir"
    fi
}
trap cleanup EXIT HUP INT TERM

hydrate_lfs_fixtures() {
    fixture_restore_dir=$(mktemp -d "${TMPDIR:-/tmp}/ennx-lfs-fixtures.XXXXXX")
    grep -RIl '^version https://git-lfs.github.com/spec/v1$' tests/fixtures \
        > "$fixture_restore_dir/paths" || true
    if [ ! -s "$fixture_restore_dir/paths" ]; then
        rm -rf "$fixture_restore_dir"
        fixture_restore_dir=
        return
    fi
    if ! git lfs version >/dev/null 2>&1; then
        echo "Git LFS is required to materialize test fixtures" >&2
        exit 1
    fi
    while IFS= read -r fixture; do
        mkdir -p "$fixture_restore_dir/files/$(dirname "$fixture")"
        cp "$fixture" "$fixture_restore_dir/files/$fixture"
        materialized="$fixture_restore_dir/materialized"
        git lfs smudge -- "$fixture" < "$fixture" > "$materialized"
        if grep -Fqx 'version https://git-lfs.github.com/spec/v1' "$materialized"; then
            echo "Git LFS object is unavailable for fixture: $fixture" >&2
            exit 1
        fi
        cp "$materialized" "$fixture"
    done < "$fixture_restore_dir/paths"
}

hydrate_lfs_fixtures

python_version=${ENNX_PYTHON_VERSION:-3.13}
case "$python_version" in
    3.12)
        python_abi=cp312
        python_environment=ennx-py312
        isolation_dir=release-py312
        ;;
    3.13)
        python_abi=cp313
        python_environment=ennx
        isolation_dir=release-py313
        ;;
    3.14)
        python_abi=cp314
        python_environment=ennx-py314
        isolation_dir=release-py314
        ;;
    *)
        echo "unsupported Python version: $python_version" >&2
        exit 1
        ;;
esac

python_bin=${ENNX_PYTHON:-}
if [ -z "$python_bin" ] && [ -n "$python_environment" ]; then
    python_bin="$repo_dir/.pixi/envs/$python_environment/bin/python"
fi
if [ -z "$python_bin" ]; then
    echo "set ENNX_PYTHON to a CPython $python_version interpreter" >&2
    exit 1
fi
case "$python_bin" in
    /*) ;;
    *) python_bin="$repo_dir/$python_bin" ;;
esac
if [ ! -x "$python_bin" ]; then
    echo "missing CPython $python_version environment; run: pixi install -e $python_environment" >&2
    exit 1
fi

build_output=$(./buck2w --isolation-dir "$isolation_dir" build //:wheel \
    --config ennx.profile=release \
    --config "ennx.python_version=$python_version" \
    --local-only \
    --num-threads 4 \
    --console none \
    --show-output)
wheel_path=$(printf '%s\n' "$build_output" | awk '$1 == "root//:wheel" { print $2 }')
if [ -z "$wheel_path" ] || [ ! -f "$wheel_path" ]; then
    echo "wheel output not found in: $build_output" >&2
    exit 1
fi
case $(basename "$wheel_path") in
    *-"$python_abi"-"$python_abi"-*.whl) ;;
    *)
        echo "wheel has the wrong Python ABI: $wheel_path" >&2
        exit 1
        ;;
esac

verify_dir=$(mktemp -d "${TMPDIR:-/tmp}/ennx-buck2-wheel.XXXXXX")
"$python_bin" -m zipfile -e "$wheel_path" "$verify_dir"

extension=$(find "$verify_dir/ennx" -maxdepth 1 -name 'ennx_rust*.so' -print)
dist_info=$(find "$verify_dir" -maxdepth 1 -type d -name 'ennx-*.dist-info' -print)
test -n "$extension"
test -n "$dist_info"
test -f "$dist_info/licenses/LICENSE"
test -f "$dist_info/licenses/NOTICE"
grep -Fqx 'Requires-Dist: numpy>=2.1' "$dist_info/METADATA"
grep -Fqx 'Requires-Dist: scipy>=1.11' "$dist_info/METADATA"
grep -Fqx 'Provides-Extra: gp' "$dist_info/METADATA"
grep -Fqx "Requires-Dist: torch>=2.0; extra == 'gp'" "$dist_info/METADATA"
grep -Fqx "Requires-Dist: gpytorch>=1.11; extra == 'gp'" "$dist_info/METADATA"

case $(uname -s) in
    Darwin)
        runtime="$verify_dir/ennx/.dylibs/libomp.dylib"
        test -f "$runtime"
        otool -L "$extension" | grep -F '@rpath/libomp.dylib'
        otool -l "$extension" | grep -A2 LC_RPATH | grep -F '@loader_path/.dylibs'
        otool -D "$runtime" | grep -F '@rpath/libomp.dylib'
        if otool -L "$extension" | grep -E '/opt/homebrew|/\\.pixi/|/Library/Caches/|conda'; then
            echo "wheel extension contains a host-specific library path" >&2
            exit 1
        fi
        ;;
    Linux)
        test ! -e "$verify_dir/ennx/.dylibs/librust_crates_ennx-py_ennx-py.so"
        readelf -d "$extension" | grep -F '$ORIGIN/.dylibs'
        if readelf -d "$extension" | grep -E '/home/|/\\.pixi/|conda'; then
            echo "wheel extension contains a host-specific library path" >&2
            exit 1
        fi
        unset LD_LIBRARY_PATH
        ;;
    *)
        echo "wheel verify is unsupported on $(uname -s)" >&2
        exit 1
        ;;
esac

ENNX_EXPECTED_PYTHON="$python_version" PYTHONPATH="$verify_dir" "$python_bin" - <<'PY'
import os
import sys

expected_python = tuple(int(part) for part in os.environ["ENNX_EXPECTED_PYTHON"].split("."))
assert sys.version_info[:2] == expected_python
assert "numpy" not in sys.modules
from ennx import _rust
from ennx import EpistemicNearestNeighbors
from ennx.experimental import DenseLinear, dense_apply, dense_dist2, dense_linear
from ennx.ennx.enn_class_support import enn_index_neighbor_distances_and_indices
from ennx.turbo.config import ENNIndexDriver
import numpy as np

center, scale = _rust.standardize_y(np.array([1.0, 2.0, 3.0]))
assert center == 2.0
assert abs(scale - 0.8164965809277261) < 1e-15

rng = np.random.default_rng(17)
train_x = rng.normal(size=(32, 5))
train_y = np.zeros((32, 1), dtype=float)
query = rng.normal(size=(4, 5))
flat = EpistemicNearestNeighbors(train_x, train_y, index_driver=ENNIndexDriver.FLAT)
usearch = EpistemicNearestNeighbors(train_x, train_y, index_driver=ENNIndexDriver.USEARCH)
expected = enn_index_neighbor_distances_and_indices(
    flat.rust_backend, query, search_k=10
)
actual = enn_index_neighbor_distances_and_indices(
    usearch.rust_backend, query, search_k=10
)
assert np.array_equal(actual[1], expected[1])
assert np.max(np.abs(actual[0] - expected[0])) == 0.0

base = np.array([0.5, -1.0, 2.0, 0.25, 4.0, -2.0, 0.75, -0.125], dtype=np.float32)
leaves = [(11, 0, 4, 0.5), (29, 4, 4, 1.25)]
terms = [(0x123456789ABCDEF0, 0.01), (91, -0.0025)]
trial, changed = dense_apply(base, leaves, terms, device="cpu")
assert changed == base.size
assert np.all(trial != base)
assert dense_dist2(leaves, terms, []) > 0.0
linear = dense_linear(
    np.array([0.25, -0.5, 1.5, 2.0], dtype=np.float32),
    np.array(
        [
            [0.5, -1.0, 0.75, 0.25],
            [-0.5, 2.0, 1.25, -0.75],
        ],
        dtype=np.float32,
    ),
    (11, 0, 0.02),
    terms,
    bias=np.array([0.125, -0.25], dtype=np.float32),
    bias_view=(29, 0, 0.01),
    device="cpu",
)
assert linear.shape == (2,)
assert np.all(np.isfinite(linear))
resident = DenseLinear(
    np.array(
        [
            [0.5, -1.0, 0.75, 0.25],
            [-0.5, 2.0, 1.25, -0.75],
        ],
        dtype=np.float32,
    ),
    (11, 0, 0.02),
    bias=np.array([0.125, -0.25], dtype=np.float32),
    bias_view=(29, 0, 0.01),
    device="cpu",
)
assert resident.input_size == 4
assert resident.output_size == 2
assert np.max(
    np.abs(
        resident.eval(
            np.array([0.25, -0.5, 1.5, 2.0], dtype=np.float32),
            terms,
        )
        - linear
    )
) == 0.0
print(f"native verify: center={center}, scale={scale}")
PY

(
    cd "$verify_dir"
    PYTHONPATH="$verify_dir" "$python_bin" -m pytest -q -p no:cacheprovider -c /dev/null \
        --confcutdir="$repo_dir/tests/python_api" \
        "$repo_dir/tests/python_api/test_create_optimizer_contract.py" \
        "$repo_dir/tests/python_api/test_adapter.py" \
        "$repo_dir/tests/python_api/test_public_api_contract.py" \
        "$repo_dir/tests/test_enn_index.py" \
        "$repo_dir/tests/test_enn_index_driver.py" \
        "$repo_dir/tests/test_enn_neighbors.py" \
        "$repo_dir/tests/test_weight_search.py"
)

if [ "$run_tests" -eq 1 ]; then
    (
        cd "$repo_dir"
        ENNX_TEST_WHEEL_ROOT="$verify_dir" \
            PYTHONPATH="$verify_dir:$repo_dir:$repo_dir/tests" \
            "$python_bin" -m pytest -q -p no:cacheprovider \
            -m 'not slow or gp' tests
    )
fi

printf '%s\n' "$wheel_path"
