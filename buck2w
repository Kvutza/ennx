#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$repo_dir/tools/bootstrap-dotslash" >/dev/null
dotslash="$repo_dir/.buck2-tools/bin/dotslash"
if [ ! -x "$dotslash" ] && [ -x "$repo_dir/.buck2-tools/bin/dotslash.exe" ]; then
    dotslash="$repo_dir/.buck2-tools/bin/dotslash.exe"
fi
case "${1:-}" in
    build|test|run)
        if [ -n "${ENNX_CXX_ROOT:-}" ]; then
            subcommand=$1
            shift
            if [ "$(uname -s)" = Darwin ]; then
                sdk=$(xcrun --show-sdk-path)
                set -- --config "ennx.cxx_sdk=$sdk" "$@"
            fi
            set -- "$subcommand" --config "ennx.cxx_root=$ENNX_CXX_ROOT" "$@"
        fi
        ;;
esac
exec "$dotslash" "$repo_dir/tools/buck2" "$@"
