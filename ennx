#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_dir"
if [ "$#" -ge 2 ] && [ "$1" = "cuda" ] && [ "$2" = "setup" ]; then
    shift 2
    exec ./tools/cuda-setup "$@"
fi
if [ "$#" -ge 2 ] && [ "$1" = "cuda" ] && [ "$(uname -s)" = Linux ]; then
    case "$2" in
        build|parity|resident|prefill|model-check|model|generate|diffusion|diffusion-check|context|ptx-probe|sanitize|bench)
            shift
            exec ./tools/cuda-run "$@"
            ;;
    esac
fi
export BUCK_ISOLATION_DIR=${BUCK_ISOLATION_DIR:-dev}
case "${ENNX_BUILD_SYSTEM:-buck2}" in
    buck2) exec ./buck2w run //rust/crates/dev-cli:ennx -- "$@" ;;
    bazel) exec bazel run --config=release --config=constrained //rust/crates/dev-cli:ennx -- "$@" ;;
    *) echo "ennx: ENNX_BUILD_SYSTEM must be buck2 or bazel" >&2; exit 1 ;;
esac
