_POINTS = [
    "dim:8192:1024:8:16",
    "dim:8192:1024:16:16",
    "dim:8192:1024:32:16",
    "dim:8192:1024:64:16",
    "dim:8192:1024:128:16",
    "dim:8192:1024:256:16",
    "dim:8192:1024:512:16",
    "dim:8192:1024:1024:16",
    "rows:1024:1024:32:16",
    "rows:4096:1024:32:16",
    "rows:16384:1024:32:16",
    "rows:65536:1024:32:16",
    "query:16384:1:32:16",
    "query:16384:8:32:16",
    "query:16384:32:32:16",
    "query:16384:128:32:16",
    "query:16384:512:32:16",
    "query:16384:2048:32:16",
    "query:16384:4096:32:16",
    "bpann:1024:1:128:16",
    "bpann:16384:1:512:16",
    "bpann:65536:1:1024:16",
    "gram:8192:8:1024:16",
    "gram:8192:32:1024:16",
    "gram:8192:128:1024:16",
    "k:8192:1024:32:1",
    "k:8192:1024:32:4",
    "k:8192:1024:32:16",
    "k:8192:1024:32:32",
    "k:8192:1024:32:64",
    "k:8192:1024:32:128",
    "k:8192:1024:32:256",
    "k:8192:1024:32:512",
    "k:8192:1024:32:1024",
    "k:8192:1024:32:2048",
]

def _exe(deps, name):
    for label, providers in deps.items():
        if label.raw_target().name == name:
            return providers[RunInfo]
    fail("missing exec dependency {}".format(name))

def _impl(ctx):
    tools = ctx.bxl_actions(
        exec_deps = [
            "root//buck2/native:faiss-metal-bench",
            "root//rust/crates/ennx:knn_frontier",
        ],
        target_platform = "prelude//platforms:default",
    )
    node = ctx.configured_targets("root//buck2/native:faiss-build")
    metallib = ctx.analysis(node).providers()[DefaultInfo].sub_targets[
        "metallib"
    ][DefaultInfo].default_outputs[0]
    faiss_out = tools.actions.declare_output(
        "faiss-metal.csv",
        has_content_based_path = False,
    )
    tools.actions.run(
        cmd_args(
            _exe(tools.exec_deps, "faiss-metal-bench"),
            faiss_out.as_output(),
            str(ctx.cli_args.rounds),
            _POINTS,
            hidden = [metallib],
        ),
        category = "faiss_metal_bench",
        env = {"FAISS_METALLIB_PATH": metallib},
    )
    ennx_out = tools.actions.declare_output(
        "ennx-knn.csv",
        has_content_based_path = False,
    )
    tools.actions.run(
        cmd_args(
            _exe(tools.exec_deps, "knn_frontier"),
            ennx_out.as_output(),
            str(ctx.cli_args.rounds),
            _POINTS,
            hidden = [faiss_out],
        ),
        category = "ennx_knn_bench",
    )
    outputs = ctx.output.ensure_multiple([faiss_out, ennx_out])
    ctx.output.print_json({
        "ennx": outputs[1].abs_path(),
        "faiss": outputs[0].abs_path(),
    })

bench = bxl_main(
    impl = _impl,
    cli_args = {
        "rounds": cli_args.int(default = 3),
    },
)
